{
  "spec_version": 1,
  "name": "dsc_mettler_toledo_v1",
  "type": "dsc",
  "model": "mettler_toledo_v1",
  "folder_name": "DSC",
  "data_layout": "file",
  "description": "Mettler Toledo DSC text export, current version (the older STARe export is dsc_mettler_toledo_v0): an 'Index' header line, a line of units, the table, then a sample/date line.",
  "file": {
    "extensions": [".txt"],
    "encoding": "auto",
    "not_contains": "Curve Values:",
    "delimiter": "whitespace",
    "header": { "starts_at": "Index", "rows": 2 },
    "data_ends": "first_non_numeric_row"
  },
  "columns": [
    { "source": ["Tr [°C]", "Tr [C]", "Temperature [°C]", "Temperature [C]"], "quantity": "temperature", "unit": "°C" },
    { "source": ["Ts [°C]", "Ts [C]"], "quantity": "sample_temperature", "unit": "°C" },
    { "source": ["t [s]", "Time [s]"], "quantity": "time", "unit": "s" },
    { "source": ["Heat Flow [mW]", "Value [mW]", "HeatFlow [mW]"], "quantity": "heat_flow", "unit": "mW" }
  ],
  "characterizer": { "type": "dsc_profiling", "sensitivity": 0.1 }
}
